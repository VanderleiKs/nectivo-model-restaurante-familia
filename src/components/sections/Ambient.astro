---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
  image: ImageMetadata;
  imageAlt: string;
}
const { eyebrow, title, image, imageAlt } = Astro.props;
---

<section id="ambiente" class="bg-background pb-16 sm:pb-20" aria-labelledby="ambiente-title">
  <Container>
    <SectionHeading id="ambiente-title" eyebrow={eyebrow} title={title} />
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 1024, 1536]}
      sizes="(min-width: 1184px) 1120px, 100vw"
      loading="lazy"
      decoding="async"
      class="mt-8 aspect-4/3 w-full rounded-brand object-cover md:aspect-16/8"
    />
  </Container>
</section>
