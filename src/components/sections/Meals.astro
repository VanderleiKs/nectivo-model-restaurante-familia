---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  items: { period: string; title: string; text: string }[];
  linkLabel: string;
  linkHref: string;
}
const { eyebrow, title, items, linkLabel, linkHref } = Astro.props;
---

<section id="refeicoes" class="bg-background py-16 sm:py-20" aria-labelledby="refeicoes-title">
  <Container>
    <SectionHeading id="refeicoes-title" eyebrow={eyebrow} title={title} />
    <ul class="mt-8 grid gap-4 md:grid-cols-2 md:gap-6">
      {items.map((m) => (
        <li class="rounded-brand border border-line bg-surface p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">{m.period}</p>
          <h3 class="mt-3 text-2xl text-highlight">{m.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{m.text}</p>
        </li>
      ))}
    </ul>
    <a href={linkHref} class="mt-6 inline-flex items-center gap-2 font-semibold text-primary hover:text-highlight">
      {linkLabel}<Icon name="arrow-right" class="size-4" />
    </a>
  </Container>
</section>
