---
import { isExternal } from '../../utils/urls';

interface Props {
  /** Com href renderiza <a>; sem href renderiza <button>. */
  href?: string;
  /** primary = âmbar sólido (um por vista); outline = contorno, ação secundária. */
  variant?: 'primary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}
const { href, variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'border border-transparent bg-primary text-on-primary hover:bg-primary-hover',
  outline: 'border border-highlight/40 text-foreground hover:border-highlight hover:bg-highlight/10',
};
const sizes = { sm: 'min-h-10 px-3.5 py-2 text-sm', md: 'min-h-12 px-5 py-3 text-base', lg: 'min-h-14 px-7 py-3.5 text-lg' };
const classes = [
  'inline-flex items-center justify-center gap-2 rounded-brand font-semibold transition duration-200 disabled:opacity-50',
  variants[variant],
  sizes[size],
  className,
];
const external = href ? isExternal(href) : false;
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      {...rest}
    >
      <slot />
      {external && <span class="sr-only">(abre em nova aba)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}><slot /></button>
  )
}
