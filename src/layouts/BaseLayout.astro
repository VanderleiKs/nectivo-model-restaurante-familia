---
import '../styles/global.css';
import Footer from '../components/common/Footer.astro';
import Header from '../components/common/Header.astro';
import WhatsAppButton from '../components/common/WhatsAppButton.astro';
import { site } from '../config/site';
import { theme, themeToCss } from '../config/theme';
import { buildSeo, organizationSchema, websiteSchema, type JsonLd, type SeoInput } from '../utils/seo';

interface Props extends SeoInput {
  /** Dados estruturados extras desta página (Schema.org). */
  schema?: JsonLd | JsonLd[];
  /** Botão flutuante de WhatsApp. Desligado neste projeto: o CTA fica no cabeçalho e na seção Visita. */
  whatsapp?: boolean;
}

const { schema, whatsapp = false, ...seoInput } = Astro.props;
const seo = buildSeo(seoInput, Astro.url.pathname);
const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = [organizationSchema(), websiteSchema(), ...extra];
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.colors.secondary} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- PROVISÓRIO: fontes via Google Fonts. Antes da entrega, hospedar localmente (public/fonts + @font-face). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Source+Sans+3:wght@400;600&display=swap"
    />
    {site.verification?.google && <meta name="google-site-verification" content={site.verification.google} />}

    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <style is:inline set:html={themeToCss()}></style>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-70 focus:rounded-brand focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
    >
      Pular para o conteúdo
    </a>
    <slot name="header"><Header /></slot>
    <main id="conteudo" class="flex-1"><slot /></main>
    <slot name="footer"><Footer /></slot>
    {whatsapp && <WhatsAppButton />}
  </body>
</html>
